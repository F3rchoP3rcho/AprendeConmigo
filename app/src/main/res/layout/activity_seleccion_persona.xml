<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ac_background"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="24dp"
    tools:context=".SeleccionPersonaActivity">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/continuar"
        android:src="@android:drawable/ic_menu_revert" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/quien_va_a_usar_la_app"
        android:textColor="@color/ac_text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/optEstudiante"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_option_unselected"
        android:gravity="center"
        android:text="@string/soy_estudiante"
        android:textColor="@color/ac_text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/optMaestro"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_option_unselected"
        android:gravity="center"
        android:text="@string/soy_maestro_tutor"
        android:textColor="@color/ac_text_primary"
        android:textSize="15sp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnContinuar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_button_primary_disabled"
        android:enabled="false"
        android:text="@string/continuar"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp" />

</LinearLayout>
